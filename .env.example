# SkillBridge Environment Configuration
SECRET_KEY=django-insecure-skillbridge-demo-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL Database Configuration
DB_ENGINE=mysql
DB_NAME=skillbridge_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Fallback to sqlite if MySQL connection fails or DB_ENGINE=sqlite
USE_SQLITE_FALLBACK=True
